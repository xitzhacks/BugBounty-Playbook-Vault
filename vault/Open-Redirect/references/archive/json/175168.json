{"id":175168,"global_id":"Z2lkOi8vaGFja2Vyb25lL1JlcG9ydC8xNzUxNjg=","url":"https://hackerone.com/reports/175168","title":"[ecommerce.shopify.com] Invalidated redirection","state":"Closed","substate":"resolved","severity_rating":"low","readable_substate":"Resolved","created_at":"2016-10-11T16:47:52.126Z","submitted_at":"2016-10-11T16:47:52.126Z","is_member_of_team?":false,"is_organization_group_member?":false,"is_triager?":false,"reporter":{"disabled":false,"username":"shailesh4594","url":"/shailesh4594","profile_picture_urls":{"small":"https://profile-photos.hackerone-user-content.com/variants/000/019/402/1cea049691b46de2c16ca91611b7673ef323e3f9_original.jpg/33193aed4df168c753cb4b15e6d5d8d6ba053ba5ee3e8d1478c137162601abe9"},"is_me?":false,"cleared":true,"verified":true,"hackerone_triager":false,"hacker_mediation":false},"team":{"id":1382,"url":"https://hackerone.com/shopify","handle":"shopify","profile_picture_urls":{"small":"https://profile-photos.hackerone-user-content.com/variants/fjjiC5585s8WoDGHv2M5okbJ/33193aed4df168c753cb4b15e6d5d8d6ba053ba5ee3e8d1478c137162601abe9","medium":"https://profile-photos.hackerone-user-content.com/variants/fjjiC5585s8WoDGHv2M5okbJ/e68529859b080f77ebfd9e0a1acafdf062bd4c43f1db58e7e55c81e6ceae2d0d"},"permissions":[],"submission_state":"open","default_currency":"usd","awards_miles":false,"offers_bounties":true,"state":"public_mode","only_cleared_hackers":false,"pentest_feature_enabled?":false,"pentest_retesting_ends_at":null,"profile":{"name":"Shopify","twitter_handle":"","website":"https://www.shopify.com","about":"Shopify is a multi-channel commerce platform that helps people sell online, in-store, and everywhere in between."}},"has_bounty?":true,"can_view_team":true,"can_view_report":true,"is_external_bug":false,"is_published":false,"is_participant":false,"has_collaborators":false,"submitted_by_team_member":false,"submitted_with_assistant":false,"stage":4,"public":true,"visibility":"full","cve_ids":[],"singular_disclosure_disabled":true,"disclosed_at":"2016-12-04T15:57:02.684Z","bug_reporter_agreed_on_going_public_at":"2016-12-04T15:57:02.649Z","team_member_agreed_on_going_public_at":"2016-11-09T22:48:23.540Z","comments_closed?":false,"facebook_team?":false,"team_private?":false,"vulnerability_information":"Hello,\n\n**Endpoint :** https://ecommerce.shopify.com/auth/shopify?shop=[victim_shop].myshopify.com\u0026return_to=/////example.com\n\nSuppose, victim has not linked his shop with ecommerce.shopify.com portal then an attacker can redirect him on an external website after linking or rejecting. \n\n**Steps to reproduce :**\n\n1. Get logged in as admin in your shop and ecommerce.shopify.com\n2. Open this link : https://ecommerce.shopify.com/auth/shopify?shop=[your-shop].myshopify.com\u0026return_to=/////example.com\n3. If you are logged in then **Link These Accounts** button and **No thanks** link will be shown.\n4. Click on **Link Account** button or **No thanks** link.\n5. You will be redirected on https://example.com instead of ecommerce.shopify.com\n6. Done\n\nAgain, your shop should not be linked to ecommerce.shopify.com.\n\n**Suggested Fix :** Use more stronger regular expression at this endpoint\n\nBest regards,\nShailesh","weakness":{"id":53,"name":"Open Redirect"},"original_report_id":null,"original_report_url":null,"attachments":[],"allow_singular_disclosure_at":null,"vote_count":9,"voters":["drsniper","eveeez","m16","paresh_parmar","dvl","alfredsaonoy","sumit7","spetr0x","alecsafk"],"severity":{"rating":"low","author_type":"Team"},"structured_scope":null,"abilities":{"assignable_team_members":[],"assignable_team_member_groups":[]},"is_exploit_agent_supported?":false,"is_linear_agent_ui_supported?":false,"summaries":[{"category":"team","can_view?":true,"can_create?":false},{"id":3033,"category":"researcher","content":"Bypassed redirection protection using 5 forward slashes!","updated_at":"2016-12-04T15:54:11.489Z","can_view?":true,"can_create?":false,"attachments":[],"user":{"id":19402,"username":"shailesh4594","name":"Shailesh Suthar","bio":"Her Love ;)","cleared":true,"verified":true,"website":"http://twitter.com/shailesh4594","location":"India (BK, Gujarat)","created_at":"2015-03-25T18:05:10.696Z","url":"https://hackerone.com/shailesh4594","hackerone_triager":false,"hackerone_employee":false,"user_type":"hacker","profile_picture_urls":{"small":"https://profile-photos.hackerone-user-content.com/variants/000/019/402/1cea049691b46de2c16ca91611b7673ef323e3f9_original.jpg/33193aed4df168c753cb4b15e6d5d8d6ba053ba5ee3e8d1478c137162601abe9","medium":"https://profile-photos.hackerone-user-content.com/variants/000/019/402/1cea049691b46de2c16ca91611b7673ef323e3f9_original.jpg/e68529859b080f77ebfd9e0a1acafdf062bd4c43f1db58e7e55c81e6ceae2d0d","xtralarge":"https://profile-photos.hackerone-user-content.com/variants/000/019/402/1cea049691b46de2c16ca91611b7673ef323e3f9_original.jpg/8c27778dedc511bdf6bd6368df973bc1d6046ad9829b0b8947661df7da50ac43"}}}]}